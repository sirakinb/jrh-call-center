# ---- JRH call center configuration ----
# Copy to .env and fill in. NEVER commit the real .env.
TWILIO_ACCOUNT_SID=ACxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_API_KEY_SID=SKxxxx
TWILIO_API_KEY_SECRET=xxxx
TWILIO_TWIML_APP_SID=APxxxx
TWILIO_BRIDGE_NUMBER=+1XXXXXXXXXX
PUBLIC_BASE_URL=https://your-public-host
STAFF_CALLER_ID=+1XXXXXXXXXX
RING_STRATEGY=simultaneous
RING_TIMEOUT=25
COMPLETION_WEBHOOK_URL=
RECORDING_NOTICE=This call will be recorded for quality and training purposes.
HOLD_MUSIC_URL=http://demo.twilio.com/docs/classic.mp3
QUEUE_NAME=jrh-queue
PORT=8080
