{
  "name": "jrh-call-center",
  "version": "0.1.0",
  "description": "JRH agent console: Twilio queue + browser-based answering with dual-channel recording, PA two-party consent, hold music, and completion webhook.",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@twilio/voice-sdk": "^2.11.1",
    "express": "^4.19.2",
    "twilio": "^5.3.0"
  },
  "devDependencies": {
    "supertest": "^7.2.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
